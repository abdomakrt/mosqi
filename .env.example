# ============================================================
#  نموذج متغيرات البيئة — انسخه إلى .env وغيّر القيم
#  cp .env.example .env
#  ثم: python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# مفتاح تشفير الجلسات — مطلوب في الإنتاج (إجباري)
# بدونه سيُستخدم مفتاح تطوير ثابت (غير آمن)
SECRET_KEY=ضع_هنا_مفتاحاً_عشوائياً_طويلاً

# كلمة مرور المدير — مطلوبة في الإنتاج
# يمكن تغييرها لاحقاً من صفحة الإعدادات (تُخزَّن مشفّرة)
ADMIN_PASSWORD=ضع_هنا_كلمة_مرور_قوية

# اضبطها على 1 إذا كان الموقع يعمل عبر HTTPS فقط (موصى به)
SESSION_COOKIE_SECURE=0
